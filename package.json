{
  "name": "vergunbuy",
  "private": true,
  "description": "Check where a renovation (starting with a carport) fits on a real Dutch plot, using public data and versioned municipal rules.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @vergunbuy/api dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "contract-check": "tsx scripts/contract-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@vergunbuy/data": "workspace:*",
    "@vergunbuy/engine": "workspace:*",
    "copc": "^0.0.9",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
